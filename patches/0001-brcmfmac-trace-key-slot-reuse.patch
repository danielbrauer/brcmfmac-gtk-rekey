From: brcmfmac GTK rekey experiments <noreply@example.invalid>
Subject: [PATCH 1/2] wifi: brcmfmac: trace key slot reuse metadata

Log slot occupancy, cached CCMP key equality and a zero-sequence flag.
Key equality describes the host cache, not live firmware state. Never log
key bytes, sequence values or addresses. This patch changes logging only.

---

diff --git a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c
@@ -2824,6 +2824,9 @@
 	s32 err;
 	u8 keybuf[8];
 	bool ext_key;
+	bool replacing;
+	bool same_ccmp_key;
+	bool seq_zero;
 
 	brcmf_dbg(TRACE, "Enter\n");
 	brcmf_dbg(CONN, "key index (%d)\n", key_idx);
@@ -2853,6 +2856,14 @@
 	}
 
 	key = &ifp->vif->profile.key[key_idx];
+	replacing = key->algo != CRYPTO_ALGO_OFF;
+	same_ccmp_key = !pairwise && replacing &&
+		params->cipher == WLAN_CIPHER_SUITE_CCMP &&
+		key->algo == CRYPTO_ALGO_AES_CCM &&
+		key->len == params->key_len &&
+		!memcmp(key->data, params->key, params->key_len);
+	seq_zero = params->seq && params->seq_len == 6 &&
+		!memchr_inv(params->seq, 0, 6);
 	memset(key, 0, sizeof(*key));
 	if ((ext_key) && (!is_multicast_ether_addr(mac_addr)))
 		memcpy((char *)&key->ea, (void *)mac_addr, ETH_ALEN);
@@ -2910,6 +2921,10 @@
 		err = -EINVAL;
 		goto done;
 	}
+
+	brcmf_info("install key: index=%u pairwise=%u ext=%u replacing=%u same_ccmp_key=%u cipher=0x%x seq_len=%u seq_zero=%u\n",
+		   key_idx, pairwise, ext_key, replacing, same_ccmp_key,
+		   params->cipher, params->seq_len, seq_zero);
 
 	err = send_key_to_dongle(ifp, key);
 	if (ext_key || err)
