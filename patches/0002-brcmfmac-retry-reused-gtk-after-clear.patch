-send_key_to_dongle(struct brcmf_if *ifp, struct brcmf_wsec_key *key)
+send_key_to_dongle(struct brcmf_if *ifp, struct brcmf_wsec_key *key,
+		   s32 *fwerr)
 {
 	struct brcmf_pub *drvr = ifp->drvr;
 	int err;
@@ -555,8 +556,8 @@ send_key_to_dongle(struct brcmf_if *ifp, struct brcmf_wsec_key *key)
 
 	brcmf_netdev_wait_pend8021x(ifp);
 
-	err = brcmf_fil_bsscfg_data_set(ifp, "wsec_key", &key_le,
-					sizeof(key_le));
+	err = brcmf_fil_bsscfg_data_set_with_fwerr(ifp, "wsec_key", &key_le,
+						   sizeof(key_le), fwerr);
 
 	if (err)
 		bphy_err(drvr, "wsec_key error (%d)\n", err);
@@ -2308,7 +2309,7 @@ brcmf_set_sharedkey(struct net_device *ndev,
 	brcmf_dbg(CONN, "key length (%d) key index (%d) algo (%d)\n",
 		  key.len, key.index, key.algo);
 	brcmf_dbg(CONN, "key \"%s\"\n", key.data);
-	err = send_key_to_dongle(ifp, &key);
+	err = send_key_to_dongle(ifp, &key, NULL);
 	if (err)
 		return err;
 
@@ -2804,12 +2805,42 @@ brcmf_cfg80211_del_key(struct wiphy *wiphy, struct net_device *ndev,
 	key->flags = BRCMF_PRIMARY_KEY;
 
 	/* Clear the key/index */
-	err = send_key_to_dongle(ifp, key);
+	err = send_key_to_dongle(ifp, key, NULL);
 
 	brcmf_dbg(TRACE, "Exit\n");
 	return err;
 }
 
+/* FWID 01-3b307371 is the tested BCM43430/2 release 9.88.4.77. */
+static bool brcmf_gtk_replay_recovery_allowed(struct brcmf_if *ifp, u8 key_idx,
+					      struct key_params *params)
+{
+	struct brcmf_pub *drvr = ifp->drvr;
+	struct brcmf_wsec_key *key = &ifp->vif->profile.key[key_idx];
+	int i;
+
+	if (drvr->bus_if->chip != BRCM_CC_43430_CHIP_ID ||
+	    drvr->bus_if->chiprev != 2 ||
+	    strcmp(drvr->fwver, "01-3b307371") ||
+	    ifp->vif->wdev.iftype != NL80211_IFTYPE_STATION ||
+	    params->cipher != WLAN_CIPHER_SUITE_CCMP ||
+	    params->key_len != 16 || !params->seq || params->seq_len != 6 ||
+	    key->algo != CRYPTO_ALGO_AES_CCM || key->len != 16 ||
+	    !(key->flags & BRCMF_PRIMARY_KEY))
+		return false;
+
+	/* Never clear to reinstall any CCMP key already present in our cache. */
+	for (i = 0; i < BRCMF_MAX_DEFAULT_KEYS; i++) {
+		key = &ifp->vif->profile.key[i];
+		if (key->algo == CRYPTO_ALGO_AES_CCM &&
+		    key->len == params->key_len &&
+		    !memcmp(key->data, params->key, params->key_len))
+			return false;
+	}
+
+	return true;
+}
+
 static s32
 brcmf_cfg80211_add_key(struct wiphy *wiphy, struct net_device *ndev,
 		       int link_id, u8 key_idx, bool pairwise,
@@ -2818,15 +2849,18 @@ brcmf_cfg80211_add_key(struct wiphy *wiphy, struct net_device *ndev,
 	struct brcmf_cfg80211_info *cfg = wiphy_to_cfg(wiphy);
 	struct brcmf_if *ifp = netdev_priv(ndev);
 	struct brcmf_pub *drvr = cfg->pub;
+	struct brcmf_wsec_key clear_key;
 	struct brcmf_wsec_key *key;
 	s32 val;
 	s32 wsec;
 	s32 err;
+	s32 fwerr = 0;
 	u8 keybuf[8];
 	bool ext_key;
 	bool replacing;
 	bool same_ccmp_key;
 	bool seq_zero;
+	bool recover_gtk;
 
 	brcmf_dbg(TRACE, "Enter\n");
 	brcmf_dbg(CONN, "key index (%d)\n", key_idx);
@@ -2864,6 +2898,8 @@ brcmf_cfg80211_add_key(struct wiphy *wiphy, struct net_device *ndev,
 		!memcmp(key->data, params->key, params->key_len);
 	seq_zero = params->seq && params->seq_len == 6 &&
 		!memchr_inv(params->seq, 0, 6);
+	recover_gtk = !pairwise && !ext_key &&
+		brcmf_gtk_replay_recovery_allowed(ifp, key_idx, params);
 	memset(key, 0, sizeof(*key));
 	if ((ext_key) && (!is_multicast_ether_addr(mac_addr)))
 		memcpy((char *)&key->ea, (void *)mac_addr, ETH_ALEN);
@@ -2926,7 +2962,20 @@ brcmf_cfg80211_add_key(struct wiphy *wiphy, struct net_device *ndev,
 		   key_idx, pairwise, ext_key, replacing, same_ccmp_key,
 		   params->cipher, params->seq_len, seq_zero);
 
-	err = send_key_to_dongle(ifp, key);
+	err = send_key_to_dongle(ifp, key, recover_gtk ? &fwerr : NULL);
+	if (err == -EBADE && fwerr == BRCMF_FWERR_REPLAY && recover_gtk) {
+		/* Preserve the requested key and receive sequence across recovery. */
+		memset(&clear_key, 0, sizeof(clear_key));
+		clear_key.index = key_idx;
+		clear_key.flags = BRCMF_PRIMARY_KEY;
+
+		err = send_key_to_dongle(ifp, &clear_key, &fwerr);
+		if (!err)
+			err = send_key_to_dongle(ifp, key, &fwerr);
+		if (!err)
+			brcmf_info("recovered GTK replay rejection at index %u\n",
+				   key_idx);
+	}
 	if (ext_key || err)
 		goto done;
 
@@ -3039,7 +3088,7 @@ brcmf_cfg80211_reconfigure_wep(struct brcmf_if *ifp)
 	if (key_idx == BRCMF_MAX_DEFAULT_KEYS)
 		return;
 
-	err = send_key_to_dongle(ifp, key);
+	err = send_key_to_dongle(ifp, key, NULL);
 	if (err) {
 		bphy_err(drvr, "Setting WEP key failed (%d)\n", err);
 		return;
