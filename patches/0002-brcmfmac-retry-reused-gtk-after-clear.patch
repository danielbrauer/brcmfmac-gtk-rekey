From: brcmfmac GTK rekey experiments <noreply@example.invalid>
Subject: [PATCH 2/2] wifi: brcmfmac: retry reused GTK slot after clear

If direct replacement of an occupied CCMP group-key slot fails, clear only
that slot using the driver's existing deletion representation and retry the
requested installation once. Do not alter initial, pairwise, successful, or
non-CCMP key operations.

---
 drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c
@@ -2818,6 +2818,7 @@ brcmf_cfg80211_add_key(struct wiphy *wiphy, struct net_device *ndev,
 	struct brcmf_cfg80211_info *cfg = wiphy_to_cfg(wiphy);
 	struct brcmf_if *ifp = netdev_priv(ndev);
 	struct brcmf_pub *drvr = cfg->pub;
+	struct brcmf_wsec_key clear_key;
 	struct brcmf_wsec_key *key;
 	s32 val;
 	s32 wsec;
@@ -2918,6 +2919,22 @@ brcmf_cfg80211_add_key(struct wiphy *wiphy, struct net_device *ndev,
 		   params->seq_len);
 
 	err = send_key_to_dongle(ifp, key);
+	if (err && !pairwise && replacing &&
+	    params->cipher == WLAN_CIPHER_SUITE_CCMP) {
+		/*
+		 * Some BCM43430 firmware rejects replacing an occupied GTK slot.
+		 * Clear only that group-key slot, then retry the requested key once.
+		 */
+		memset(&clear_key, 0, sizeof(clear_key));
+		clear_key.index = key_idx;
+		clear_key.flags = BRCMF_PRIMARY_KEY;
+
+		brcmf_info("retry reused CCMP group key index %u after clear\n",
+			   key_idx);
+		err = send_key_to_dongle(ifp, &clear_key);
+		if (!err)
+			err = send_key_to_dongle(ifp, key);
+	}
 	if (ext_key || err)
 		goto done;
 
