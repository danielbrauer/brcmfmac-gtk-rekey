From 013548b076250ec91939244737b3df6ebfeaedab Mon Sep 17 00:00:00 2001
From: Daniel Brauer <messagetodaniel@gmail.com>
Date: Wed, 9 Sep 2026 14:58:53 +0200
Subject: [RFC PATCH 1/2] wifi: brcmfmac: expose per-call firmware status for
 bsscfg writes

The firmware interface maps firmware failures to -EBADE by default.
Callers which need to distinguish individual firmware errors can only
change the interface-wide fwil_fwerr flag, which also changes the return
convention for other operations on that interface.

Add an optional firmware-status output to a bsscfg write helper. Capture
that status under the existing protocol lock and report zero when the
request fails before receiving a successful transport reply. With the
output supplied, retain the normal Linux errno return independently of
fwil_fwerr. Existing callers continue to use their previous convention.

This prepares a GTK replacement workaround which must distinguish a
specific firmware rejection from transport errors without changing shared
error-reporting state.

AI assistance was used to develop the implementation and its tests.
Assisted-by: LLM
---
 .../broadcom/brcm80211/brcmfmac/fwil.c        | 60 +++++++++++++++----
 .../broadcom/brcm80211/brcmfmac/fwil.h        |  2 +
 2 files changed, 49 insertions(+), 13 deletions(-)

diff --git a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/fwil.c b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/fwil.c
index 6385a7d..d8cfe48 100644
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/fwil.c
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/fwil.c
@@ -94,10 +94,14 @@ static const char *brcmf_fil_get_errstr(u32 err)
 #endif /* DEBUG */
 
 static s32
-brcmf_fil_cmd_data(struct brcmf_if *ifp, u32 cmd, void *data, u32 len, bool set)
+brcmf_fil_cmd_data(struct brcmf_if *ifp, u32 cmd, void *data, u32 len,
+		   bool set, s32 *fwerr_out)
 {
 	struct brcmf_pub *drvr = ifp->drvr;
-	s32 err, fwerr;
+	s32 err, fwerr = 0;
+
+	if (fwerr_out)
+		*fwerr_out = 0;
 
 	if (drvr->bus_if->state != BRCMF_BUS_UP) {
 		bphy_err(drvr, "bus is down. we have nothing to do.\n");
@@ -113,6 +117,10 @@ brcmf_fil_cmd_data(struct brcmf_if *ifp, u32 cmd, void *data, u32 len, bool set)
 		err = brcmf_proto_query_dcmd(drvr, ifp->ifidx, cmd,
 					     data, len, &fwerr);
 
+	/* A transport failure must not be mistaken for a firmware reply. */
+	if (!err && fwerr_out)
+		*fwerr_out = fwerr;
+
 	if (err) {
 		brcmf_dbg(FIL, "Failed: error=%d\n", err);
 	} else if (fwerr < 0) {
@@ -120,7 +128,8 @@ brcmf_fil_cmd_data(struct brcmf_if *ifp, u32 cmd, void *data, u32 len, bool set)
 			  brcmf_fil_get_errstr((u32)(-fwerr)), fwerr);
 		err = -EBADE;
 	}
-	if (ifp->fwil_fwerr)
+	/* Explicit status callers always receive the normal Linux errno. */
+	if (!fwerr_out && ifp->fwil_fwerr)
 		return fwerr;
 
 	return err;
@@ -137,7 +146,7 @@ brcmf_fil_cmd_data_set(struct brcmf_if *ifp, u32 cmd, void *data, u32 len)
 	brcmf_dbg_hex_dump(BRCMF_FIL_ON(), data,
 			   min_t(uint, len, MAX_HEX_DUMP_LEN), "data\n");
 
-	err = brcmf_fil_cmd_data(ifp, cmd, data, len, true);
+	err = brcmf_fil_cmd_data(ifp, cmd, data, len, true, NULL);
 	mutex_unlock(&ifp->drvr->proto_block);
 
 	return err;
@@ -150,7 +159,7 @@ brcmf_fil_cmd_data_get(struct brcmf_if *ifp, u32 cmd, void *data, u32 len)
 	s32 err;
 
 	mutex_lock(&ifp->drvr->proto_block);
-	err = brcmf_fil_cmd_data(ifp, cmd, data, len, false);
+	err = brcmf_fil_cmd_data(ifp, cmd, data, len, false, NULL);
 
 	brcmf_dbg(FIL, "ifidx=%d, cmd=%d, len=%d, err=%d\n", ifp->ifidx, cmd,
 		  len, err);
@@ -202,7 +211,7 @@ brcmf_fil_iovar_data_set(struct brcmf_if *ifp, const char *name, const void *dat
 				    sizeof(drvr->proto_buf));
 	if (buflen) {
 		err = brcmf_fil_cmd_data(ifp, BRCMF_C_SET_VAR, drvr->proto_buf,
-					 buflen, true);
+					 buflen, true, NULL);
 	} else {
 		err = -EPERM;
 		bphy_err(drvr, "Creating iovar failed\n");
@@ -227,7 +236,7 @@ brcmf_fil_iovar_data_get(struct brcmf_if *ifp, const char *name, void *data,
 				    sizeof(drvr->proto_buf));
 	if (buflen) {
 		err = brcmf_fil_cmd_data(ifp, BRCMF_C_GET_VAR, drvr->proto_buf,
-					 buflen, false);
+					 buflen, false, NULL);
 		if (err == 0)
 			memcpy(data, drvr->proto_buf, len);
 	} else {
@@ -290,14 +299,32 @@ brcmf_create_bsscfg(s32 bsscfgidx, const char *name, char *data, u32 datalen,
 	return iolen;
 }
 
+/**
+ * brcmf_fil_bsscfg_data_set_with_fwerr() - Write a BSS configuration variable.
+ * @ifp: Interface to configure.
+ * @name: Firmware variable name.
+ * @data: Variable data.
+ * @len: Size of @data in bytes.
+ * @fwerr: Optional firmware status output; zero on host or transport failure.
+ *
+ * Serialize the request and capture its status under the protocol lock.
+ * If @fwerr is provided, return the Linux error independently of the legacy
+ * interface-wide fwil_fwerr setting. If it is NULL, preserve that setting.
+ *
+ * Return: Zero on success or a Linux error when @fwerr is provided; otherwise
+ * the legacy return value selected by fwil_fwerr.
+ */
 s32
-brcmf_fil_bsscfg_data_set(struct brcmf_if *ifp, const char *name,
-			  void *data, u32 len)
+brcmf_fil_bsscfg_data_set_with_fwerr(struct brcmf_if *ifp, const char *name,
+				     void *data, u32 len, s32 *fwerr)
 {
 	struct brcmf_pub *drvr = ifp->drvr;
 	s32 err;
 	u32 buflen;
 
+	if (fwerr)
+		*fwerr = 0;
+
 	mutex_lock(&drvr->proto_block);
 
 	brcmf_dbg(FIL, "ifidx=%d, bsscfgidx=%d, name=%s, len=%d\n", ifp->ifidx,
@@ -309,7 +336,7 @@ brcmf_fil_bsscfg_data_set(struct brcmf_if *ifp, const char *name,
 				     drvr->proto_buf, sizeof(drvr->proto_buf));
 	if (buflen) {
 		err = brcmf_fil_cmd_data(ifp, BRCMF_C_SET_VAR, drvr->proto_buf,
-					 buflen, true);
+					 buflen, true, fwerr);
 	} else {
 		err = -EPERM;
 		bphy_err(drvr, "Creating bsscfg failed\n");
@@ -318,6 +345,13 @@ brcmf_fil_bsscfg_data_set(struct brcmf_if *ifp, const char *name,
 	mutex_unlock(&drvr->proto_block);
 	return err;
 }
+
+s32
+brcmf_fil_bsscfg_data_set(struct brcmf_if *ifp, const char *name,
+			  void *data, u32 len)
+{
+	return brcmf_fil_bsscfg_data_set_with_fwerr(ifp, name, data, len, NULL);
+}
 BRCMF_EXPORT_SYMBOL_GPL(brcmf_fil_bsscfg_data_set);
 
 s32
@@ -334,7 +368,7 @@ brcmf_fil_bsscfg_data_get(struct brcmf_if *ifp, const char *name,
 				     drvr->proto_buf, sizeof(drvr->proto_buf));
 	if (buflen) {
 		err = brcmf_fil_cmd_data(ifp, BRCMF_C_GET_VAR, drvr->proto_buf,
-					 buflen, false);
+					 buflen, false, NULL);
 		if (err == 0)
 			memcpy(data, drvr->proto_buf, len);
 	} else {
@@ -390,7 +424,7 @@ s32 brcmf_fil_xtlv_data_set(struct brcmf_if *ifp, const char *name, u16 id,
 				   drvr->proto_buf, sizeof(drvr->proto_buf));
 	if (buflen) {
 		err = brcmf_fil_cmd_data(ifp, BRCMF_C_SET_VAR, drvr->proto_buf,
-					 buflen, true);
+					 buflen, true, NULL);
 	} else {
 		err = -EPERM;
 		bphy_err(drvr, "Creating xtlv failed\n");
@@ -414,7 +448,7 @@ s32 brcmf_fil_xtlv_data_get(struct brcmf_if *ifp, const char *name, u16 id,
 				   drvr->proto_buf, sizeof(drvr->proto_buf));
 	if (buflen) {
 		err = brcmf_fil_cmd_data(ifp, BRCMF_C_GET_VAR, drvr->proto_buf,
-					 buflen, false);
+					 buflen, false, NULL);
 		if (err == 0)
 			memcpy(data, drvr->proto_buf, len);
 	} else {
diff --git a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/fwil.h b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/fwil.h
index ab3d6cf..f6a65d2 100644
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/fwil.h
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/fwil.h
@@ -146,6 +146,8 @@ s32 brcmf_fil_iovar_int_query(struct brcmf_if *ifp, const char *name, u32 *data)
 }
 
 
+s32 brcmf_fil_bsscfg_data_set_with_fwerr(struct brcmf_if *ifp, const char *name,
+					 void *data, u32 len, s32 *fwerr);
 s32 brcmf_fil_bsscfg_data_set(struct brcmf_if *ifp, const char *name,
 			      void *data, u32 len);
 s32 brcmf_fil_bsscfg_data_get(struct brcmf_if *ifp, const char *name,
